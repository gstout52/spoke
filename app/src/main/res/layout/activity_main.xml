<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spoke"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Tap any text field, then tap the floating mic. Tap it again to finish. Long-press while recording to cancel. Drag it to move it."
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- Setup -->
        <TextView
            style="@style/SectionHeader"
            android:text="1. Setup" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMic"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow microphone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotifications"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow notifications" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccessibility"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Turn on Spoke in Accessibility" />

        <TextView
            android:id="@+id/restrictedHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="If Samsung says the setting is restricted: tap the button below, open the ⋮ menu (top right), choose “Allow restricted settings”, then try Accessibility again."
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAppInfo"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open Spoke app info" />

        <!-- Transcription -->
        <TextView
            style="@style/SectionHeader"
            android:text="2. Speech-to-text" />

        <RadioGroup
            android:id="@+id/providerGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/providerGroq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Groq Whisper (free tier)" />

            <RadioButton
                android:id="@+id/providerOpenai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OpenAI" />
        </RadioGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/groqKeyLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Groq API key (console.groq.com)"
            app:endIconMode="password_toggle"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/groqKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/openaiKeyLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="OpenAI API key (platform.openai.com)"
            app:endIconMode="password_toggle"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/openaiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Cleanup -->
        <TextView
            style="@style/SectionHeader"
            android:text="3. Cleanup (Claude)" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/cleanupSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remove filler words, fix punctuation, apply corrections" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Anthropic API key (console.anthropic.com)"
            app:endIconMode="password_toggle"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/anthropicKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Vocabulary -->
        <TextView
            style="@style/SectionHeader"
            android:text="4. Your vocabulary" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Names and terms to spell correctly (one per line)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/vocabulary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Save" />

        <!-- Try it -->
        <TextView
            style="@style/SectionHeader"
            android:text="5. Try it" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tap here, then tap the mic">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
